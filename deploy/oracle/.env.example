# Copy to deploy/oracle/.env (gitignored) and fill in. Never commit the real file.

# --- Public address (no domain needed) ---
# Your VM's public IP with dots replaced by dashes + .sslip.io, e.g. 1-2-3-4.sslip.io
PUBLIC_HOST=
# Must be exactly https://<PUBLIC_HOST>, e.g. https://1-2-3-4.sslip.io
WEBAPP_URL=

# --- Telegram ---
BOT_TOKEN=
# Owners (comma-separated Telegram user IDs)
ADMINS=
# Optional: superadmins may add / remove users in the Mini App
SUPERADMINS=
ip=

# DATABASE_URL, WEBAPP_HOST and PORT are set in docker-compose.yml (SQLite at /data/finance.db, port 8080).

# --- AI provider: gemini (default, also reads voice messages) or claude ---
AI_PROVIDER=gemini

# --- Google Gemini (key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional: several free-tier keys, comma-separated; when one hits its quota the bot switches to the next
# GEMINI_API_KEYS=key1,key2
# Optional overrides. Leave them commented out to use the app defaults: an EMPTY value breaks
# startup for numbers/booleans and replaces model names with "".
# GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
# GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT=60
# GEMINI_ANALYSIS_TIMEOUT=180

# --- Anthropic Claude (used when AI_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
# CLAUDE_EXTRACT_MODEL=claude-haiku-5-5
# CLAUDE_ANALYSIS_MODEL=claude-opus-5-5
# CLAUDE_TIMEOUT=60
# CLAUDE_ANALYSIS_TIMEOUT=180
# CLAUDE_REFUSAL_FALLBACK=true
