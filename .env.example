# CREATE A NEW .env FILE AND
# WRITE THE FOLLOWING INFORMATION:

ADMINS=12345678,12345677,12345676
BOT_TOKEN=123452345243:Asdfasdfasf
ip=localhost

# --- Finora features ---
DATABASE_URL=sqlite+aiosqlite:///./finora.db
WEBAPP_URL=http://localhost:8000

# --- AI provider: gemini (default, also reads voice messages) or claude ---
AI_PROVIDER=gemini

# --- Google Gemini (Google AI Studio key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=60
GEMINI_ANALYSIS_TIMEOUT=180

# --- Anthropic Claude (used when AI_PROVIDER=claude; key: https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=sk-ant-your-api-key
CLAUDE_EXTRACT_MODEL=claude-haiku-5-5
CLAUDE_ANALYSIS_MODEL=claude-opus-5-5
CLAUDE_TIMEOUT=60
CLAUDE_ANALYSIS_TIMEOUT=180
CLAUDE_REFUSAL_FALLBACK=true
